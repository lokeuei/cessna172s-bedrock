{
  "format_version": "1.8.0",
  "animations": {
    "animation.skyhawk.flight_v284": {
      "loop": true,
      "bones": {
        "root": {
          "rotation": [
            "-q.property('skyhawk:pitch')",
            "q.property('skyhawk:yaw') - q.body_y_rotation",
            "-q.property('skyhawk:bank')"
          ]
        },
        "propeller": {
          "rotation": [
            0,
            0,
            "q.property('skyhawk:power') > 0 ? q.life_time * (1100 + q.property('skyhawk:power') * 16) : 0"
          ]
        }
      }
    }
  }
}
